DATABASE_URL=postgresql:///puckdesk
# Random string; the MCP endpoint is /mcp/<secret>. Generate with: uv run puckdesk new-secret
PUCKDESK_SECRET=
PUCKDESK_HOST=127.0.0.1
PUCKDESK_PORT=8765
# Public host name from Tailscale Funnel, e.g. mac-mini.tail1234.ts.net (no https://)
PUCKDESK_PUBLIC_HOST=
# Yahoo Fantasy Sports API, after Yahoo approves access
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
